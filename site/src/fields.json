 "steps": [
  {
   "id": "A1",
   "section": "A",
   "title": "Your tax file number",
   "fieldIds": [
    "tfn",
    "tfn_applied",
    "tfn_under18",
    "tfn_pension"
   ],
   "help": "Use your TFN, or tick one of the three exceptions if you do not have one yet."
  },
  {
   "id": "A2",
   "section": "A",
   "title": "Your name",
   "fieldIds": [
    "title",
    "surname",
    "given_name",
    "other_names"
   ],
   "help": "Title is optional. Surname and first given name are needed."
  },
  {
   "id": "A3",
   "section": "A",
   "title": "Your home address in Australia",
   "fieldIds": [
    "addr1",
    "addr2",
    "suburb",
    "state",
    "postcode"
   ],
   "help": "The address where you live."
  },
  {
   "id": "A4",
   "section": "A",
   "title": "Previous family name",
   "fieldIds": [
    "prev_name"
   ],
   "help": "Only fill this in if you changed your name since you last dealt with the ATO."
  },
  {
   "id": "A5",
   "section": "A",
   "title": "Your e-mail address",
   "fieldIds": [
    "email"
   ],
   "help": "Optional. Your primary e-mail address."
  },
  {
   "id": "A6",
   "section": "A",
   "title": "Your date of birth",
   "fieldIds": [
    "dob"
   ],
   "help": "Day, month and year."
  },
  {
   "id": "A7",
   "section": "A",
   "title": "How are you paid?",
   "fieldIds": [
    "basis"
   ],
   "help": "Select only one."
  },
  {
   "id": "A8",
   "section": "A",
   "title": "Your tax residency",
   "fieldIds": [
    "residency"
   ],
   "help": "Select only one."
  },
  {
   "id": "A9",
   "section": "A",
   "title": "Tax-free threshold",
   "fieldIds": [
    "tax_free"
   ],
   "help": "Only claim the tax-free threshold from one payer at a time, unless your total income will be under the threshold."
  },
  {
   "id": "A10",
   "section": "A",
   "title": "Study and training loans",
   "fieldIds": [
    "help_debt"
   ],
   "help": "HELP, VSL, FS, SSL or TSL debt? Your payer withholds extra to cover repayments."
  },
  {
   "id": "A11",
   "section": "A",
   "title": "Sign and date your declaration",
   "fieldIds": [
    "sig_a",
    "date_a"
   ],
   "help": "You declare that the information is true and correct. There are penalties for deliberately making a false or misleading statement."
  },
  {
   "id": "B1",
   "section": "B",
   "title": "Payer: ABN or withholding payer number",
   "fieldIds": [
    "abn",
    "branch"
   ],
   "help": "Payer section (optional): your employer can complete this."
  },
  {
   "id": "B2",
   "section": "B",
   "title": "Payer: applied for an ABN?",
   "fieldIds": [
    "abn_applied"
   ],
   "help": "Only if the payer has no ABN or withholding payer number."
  },
  {
   "id": "B3",
   "section": "B",
   "title": "Payer: business name",
   "fieldIds": [
    "biz_name1",
    "biz_name2",
    "biz_name3"
   ],
   "help": "Legal name or registered business name (or individual name if not in business)."
  },
  {
   "id": "B4",
   "section": "B",
   "title": "Payer: business address",
   "fieldIds": [
    "biz_addr1",
    "biz_addr2",
    "biz_suburb",
    "biz_state",
    "biz_postcode"
   ],
   "help": ""
  },
  {
   "id": "B5",
   "section": "B",
   "title": "Payer: e-mail address",
   "fieldIds": [
    "biz_email"
   ],
   "help": "Optional."
  },
  {
   "id": "B6",
   "section": "B",
   "title": "Payer: contact person",
   "fieldIds": [
    "contact",
    "biz_phone"
   ],
   "help": "Who the ATO should contact, and a business phone number."
  },
  {
   "id": "B7",
   "section": "B",
   "title": "Payer: no longer paying this payee?",
   "fieldIds": [
    "payee_ceased"
   ],
   "help": "Print X only if you no longer make payments to this payee."
  },
  {
   "id": "B8",
   "section": "B",
   "title": "Payer: sign and date",
   "fieldIds": [
    "sig_b",
    "date_b"
   ],
   "help": "Payer declaration that the information is true and correct."
  }
 ],
